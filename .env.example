# Copy the appropriate settings into each file listed below.
# packages/database/.env — Neon connection panel, same branch/database
DIRECT_URL=
DATABASE_URL=

# apps/web/.env.local — also set DATABASE_URL to the pooled Neon URL
AUTH_URL=http://localhost:3000
AUTH_SECRET=
INTERNAL_AUTH_SECRET=
API_BASE_URL=http://localhost:4000/api
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# apps/api/.env — also set DATABASE_URL and the same INTERNAL_AUTH_SECRET as web
PORT=4000
CORS_ORIGINS=http://localhost:3000

# GitHub App (repository connections, pull requests, source context, webhooks) — server-only in apps/api/.env
# Required repository permissions: Metadata (Read), Pull requests (Read), Contents (Read).
# Private key newlines may use \n escapes when stored on a single line.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI Coding Agents & Worker (server-only in apps/api/.env and apps/worker/.env)
# AI_PROVIDER accepts: openai | anthropic | openai-compatible
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_API_BASE_URL=
AI_TIMEOUT_MS=45000
AI_PRICE_INPUT_PER_1M=0
AI_PRICE_OUTPUT_PER_1M=0
SANDBOX_ENABLED=true
SANDBOX_DOCKER_IMAGE=node:24-alpine
WORKER_POLL_INTERVAL_MS=2500

# Browser IDE & Workspace Execution Runtime (server-only in apps/api/.env and apps/worker/.env)
WORKER_URL=http://127.0.0.1:4100
WORKER_PORT=4100
WORKER_BIND_HOST=127.0.0.1
WORKER_TERMINAL_PUBLIC_URL=ws://localhost:4100/terminal
# Brick 8 real-time collaboration WebSocket (/collab) automatically derives from WORKER_TERMINAL_PUBLIC_URL.
# WORKSPACE_STORAGE_MODE accepts: ephemeral | local_volume | durable
WORKSPACE_STORAGE_MODE=ephemeral
WORKSPACE_STORAGE_DIR=
WORKSPACE_SNAPSHOT_DIR=
WORKSPACE_TERMINAL_ENABLED=true
WORKSPACE_TTL_HOURS=24
