# DevCollab Monorepo Environment Index
# Do NOT run services expecting the root .env file alone.
# Configure the package-specific files (see each package's .env.example):
#   - packages/database/.env
#   - apps/web/.env.local
#   - apps/api/.env
#   - apps/worker/.env
# Run `pnpm env:check` to validate local configuration without printing secrets.

# -----------------------------------------------------------------------------
# Neon PostgreSQL (packages/database/.env; pooled URL also used in web/api/worker)
# -----------------------------------------------------------------------------
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Web Frontend & Auth.js (apps/web/.env.local)
# -----------------------------------------------------------------------------
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-with-crypto-randomBytes-32-base64
INTERNAL_AUTH_SECRET=must-match-across-web-api-and-worker-min-32-chars
API_BASE_URL=http://localhost:4000/api
# Optional OAuth providers (keep empty if using email/password only)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_REPOSITORY_URL=

# -----------------------------------------------------------------------------
# NestJS API Server (apps/api/.env)
# -----------------------------------------------------------------------------
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Optional GitHub App Integration (apps/api/.env + GITHUB_APP_ID/KEY in apps/worker/.env)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# Optional AI Coding Agents & IDE Assistant (apps/api/.env and apps/worker/.env)
# AI_PROVIDER accepts: openai | anthropic | openai-compatible
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_API_BASE_URL=
AI_TIMEOUT_MS=45000
AI_PRICE_INPUT_PER_1M=0
AI_PRICE_OUTPUT_PER_1M=0
AI_MAX_CONTEXT_FILES=24
AI_MAX_CONTEXT_BYTES=96000

# -----------------------------------------------------------------------------
# Worker Runtime, Sandbox, Browser IDE & Collaboration (apps/api/.env & apps/worker/.env)
# Enable SANDBOX_ENABLED=true and WORKSPACE_TERMINAL_ENABLED=true ONLY when Docker is available.
# -----------------------------------------------------------------------------
WORKER_URL=http://127.0.0.1:4100
WORKER_PORT=4100
WORKER_BIND_HOST=127.0.0.1
WORKER_TERMINAL_PUBLIC_URL=ws://localhost:4100/terminal
WORKER_POLL_INTERVAL_MS=2500
WORKER_LEASE_DURATION_MS=180000
SANDBOX_ENABLED=false
SANDBOX_DOCKER_IMAGE=node:24-alpine
SANDBOX_TIMEOUT_MS=60000
WORKSPACE_STORAGE_MODE=ephemeral
WORKSPACE_STORAGE_DIR=
WORKSPACE_SNAPSHOT_DIR=
WORKSPACE_TERMINAL_ENABLED=false
WORKSPACE_TERMINAL_IDLE_MS=600000
WORKSPACE_MAX_FILE_BYTES=524288
WORKSPACE_TTL_HOURS=24
