# @devcollab/web — Copy to apps/web/.env.local

# Pooled Neon PostgreSQL connection (for Auth.js adapter & DB-backed login rate limits)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Canonical public URL of the Next.js web app
AUTH_URL=http://localhost:3000

# Cryptographically random 32+ character secret for Auth.js JWT sessions
AUTH_SECRET=

# Shared 32+ character HS256 secret matching apps/api/.env and apps/worker/.env
INTERNAL_AUTH_SECRET=

# Internal base URL of the NestJS API server
API_BASE_URL=http://localhost:4000/api

# Optional OAuth providers (set client ID + secret to enable login buttons)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional repository link displayed on public marketing pages
GITHUB_REPOSITORY_URL=
