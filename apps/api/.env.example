# @devcollab/api — Copy to apps/api/.env

# Pooled Neon PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Shared 32+ character HS256 secret matching apps/web/.env.local and apps/worker/.env
INTERNAL_AUTH_SECRET=

# HTTP server & CORS origin allowlist
PORT=4000
CORS_ORIGINS=http://localhost:3000

# Optional GitHub App Integration (repository connections, PR sync, webhooks)
# Private key newlines may use \n escapes on a single line.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# Optional AI Provider (openai | anthropic | openai-compatible)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_API_BASE_URL=
AI_TIMEOUT_MS=45000
AI_PRICE_INPUT_PER_1M=0
AI_PRICE_OUTPUT_PER_1M=0
AI_MAX_CONTEXT_FILES=24
AI_MAX_CONTEXT_BYTES=96000

# Worker client, real-time collaboration (/collab derived from terminal URL), and sandbox policy
# Keep SANDBOX_ENABLED=false unless Docker Engine is installed and running.
WORKER_URL=http://127.0.0.1:4100
WORKER_TERMINAL_PUBLIC_URL=ws://localhost:4100/terminal
WORKSPACE_TTL_HOURS=24
SANDBOX_ENABLED=false
SANDBOX_DOCKER_IMAGE=node:24-alpine
