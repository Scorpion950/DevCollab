{
  "name": "@devcollab/worker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsc && node --env-file-if-exists=.env --env-file-if-exists=../api/.env dist/main.js",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../api/.env dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/worker-sandbox.test.cjs test/workspace-runtime.test.cjs test/collab-gateway.test.cjs"
  },
  "dependencies": {
    "@devcollab/ai-core": "workspace:*",
    "@devcollab/database": "workspace:*",
    "@devcollab/shared": "workspace:*",
    "lib0": "^0.2.120",
    "ws": "^8.23.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
