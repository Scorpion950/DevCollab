# @devcollab/worker — Copy to apps/worker/.env

# Pooled Neon PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Shared 32+ character HS256 secret matching apps/web/.env.local and apps/api/.env
INTERNAL_AUTH_SECRET=

# Worker HTTP & WebSocket server (/terminal and /collab Yjs CRDT gateway)
WORKER_PORT=4100
WORKER_BIND_HOST=127.0.0.1
WORKER_TERMINAL_PUBLIC_URL=ws://localhost:4100/terminal
CORS_ORIGINS=http://localhost:3000
WORKER_POLL_INTERVAL_MS=2500
WORKER_LEASE_DURATION_MS=180000

# Sandbox & terminal isolation
# CRITICAL: Keep SANDBOX_ENABLED=false and WORKSPACE_TERMINAL_ENABLED=false when Docker is unavailable.
# DevCollab never falls back to unsafe host shell execution.
SANDBOX_ENABLED=false
SANDBOX_DOCKER_IMAGE=node:24-alpine
SANDBOX_TIMEOUT_MS=60000
WORKSPACE_TERMINAL_ENABLED=false
WORKSPACE_TERMINAL_IDLE_MS=600000

# Isolated workspace filesystem (leave storage/snapshot dirs empty to use <repo>/.devcollab-workspaces)
# WORKSPACE_STORAGE_MODE accepts: ephemeral | local_volume | durable
WORKSPACE_STORAGE_MODE=ephemeral
WORKSPACE_STORAGE_DIR=
WORKSPACE_SNAPSHOT_DIR=
WORKSPACE_MAX_FILE_BYTES=524288

# Optional GitHub App tarball/context credentials (must match apps/api/.env when configured)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_API_BASE_URL=https://api.github.com

# Optional AI Provider settings (must match apps/api/.env when configured)
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_API_BASE_URL=
AI_TIMEOUT_MS=45000
AI_PRICE_INPUT_PER_1M=0
AI_PRICE_OUTPUT_PER_1M=0
AI_MAX_CONTEXT_FILES=24
AI_MAX_CONTEXT_BYTES=96000
