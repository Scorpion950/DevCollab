generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id                   String                   @id @default(cuid())
  name                 String?
  email                String                   @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  accounts             Account[]
  sessions             Session[]
  memberships          OrganizationMembership[]
  sentInvitations      OrganizationInvitation[] @relation("InvitationSender")
  acceptedInvitations  OrganizationInvitation[] @relation("InvitationAcceptor")
  createdProjects      Project[]                @relation("ProjectCreator")
  projectRoles         ProjectRoleAssignment[]  @relation("ProjectAssignee")
  assignedProjectRoles ProjectRoleAssignment[]  @relation("ProjectAssigner")
  auditLogs            OrganizationAuditLog[]
  assignedTasks        Task[]                   @relation("TaskAssignee")
  createdTasks         Task[]                   @relation("TaskCreator")
  taskComments         TaskComment[]
  taskActivities       TaskActivity[]
  githubInstallations  OrganizationGitHubInstallation[]
  githubInstallStates  GitHubInstallSession[]
  connectedRepos       ProjectRepository[]      @relation("RepoConnector")
  prReviewComments     PullRequestReviewComment[] @relation("PRCommentAuthor")
  resolvedPrComments   PullRequestReviewComment[] @relation("PRCommentResolver")
  prInternalReviews    PullRequestInternalReview[]
  linkedTaskPrs        TaskPullRequestLink[]    @relation("TaskPrLinker")
  triggeredAgentRuns   AgentRun[]               @relation("AgentRunTrigger")
  decidedAgentPlans    AgentPlan[]              @relation("AgentPlanDecider")
  reviewedAgentProposals AgentProposal[]        @relation("AgentProposalReviewer")
  agentRunEvents       AgentRunEvent[]          @relation("AgentEventActor")
  ownedWorkspaces      DevWorkspace[]           @relation("WorkspaceOwner")
  workspaceSnapshots   WorkspaceSnapshot[]      @relation("WorkspaceSnapshotCreator")
  workspaceEvents      WorkspaceEvent[]         @relation("WorkspaceEventActor")
  terminalSessions     WorkspaceTerminalSession[] @relation("WorkspaceTerminalUser")
  createdCollabSessions   CollabSession[]         @relation("CollabSessionCreator")
  closedCollabSessions    CollabSession[]         @relation("CollabSessionCloser")
  collabParticipations    CollabParticipant[]     @relation("CollabParticipantUser")
  collabInvitationsSent   CollabParticipant[]     @relation("CollabParticipantInviter")
  collabMessages          CollabMessage[]         @relation("CollabMessageAuthor")
  collabDocumentsEdited   CollabDocument[]        @relation("CollabDocumentEditor")
  aiConversations         AiConversation[]        @relation("AiConversationOwner")
  aiMessages              AiMessage[]             @relation("AiMessageAuthor")
  aiAssistantUsageRecords AiAssistantUsageRecord[] @relation("AiAssistantUsageUser")
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
}
model Session {
  sessionToken String @id
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@id([identifier, token])
}
model AuthAttempt {
  key String @id
  count Int
  expires DateTime
  @@index([expires])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  description String?                  @db.Text
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  projects    Project[]
  auditLogs   OrganizationAuditLog[]
  tasks       Task[]
  githubInstallations OrganizationGitHubInstallation[]
  githubInstallStates GitHubInstallSession[]
  projectRepositories ProjectRepository[]
  pullRequests        PullRequest[]
  prReviewComments    PullRequestReviewComment[]
  prInternalReviews   PullRequestInternalReview[]
  taskPrLinks         TaskPullRequestLink[]
  agentRuns           AgentRun[]
  agentRunEvents      AgentRunEvent[]
  agentUsageRecords   AgentUsageRecord[]
  devWorkspaces       DevWorkspace[]
  workspaceEvents     WorkspaceEvent[]
  terminalSessions    WorkspaceTerminalSession[]
  collabSessions      CollabSession[]
  collabMessages      CollabMessage[]
  aiConversations     AiConversation[]
  aiAssistantUsageRecords AiAssistantUsageRecord[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(MEMBER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  activeLock     String?
  invitedById    String?
  acceptedById   String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, email, activeLock])
  @@index([organizationId, status])
  @@index([email, status])
}

model Project {
  id              String                  @id @default(cuid())
  organizationId  String
  name            String
  key             String
  slug            String
  description     String?                 @db.Text
  status                ProjectStatus           @default(ACTIVE)
  nextTaskNumber        Int                     @default(1)
  allowDeveloperAiRuns  Boolean                 @default(false)
  createdById           String?
  archivedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             User?                   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  roleAssignments       ProjectRoleAssignment[]
  auditLogs             OrganizationAuditLog[]
  tasks                 Task[]
  taskActivities        TaskActivity[]
  githubInstallStates   GitHubInstallSession[]
  repositories          ProjectRepository[]
  pullRequests          PullRequest[]
  prReviewComments      PullRequestReviewComment[]
  prInternalReviews     PullRequestInternalReview[]
  taskPrLinks           TaskPullRequestLink[]
  agentRuns             AgentRun[]
  agentRunEvents        AgentRunEvent[]
  agentUsageRecords     AgentUsageRecord[]
  devWorkspaces         DevWorkspace[]
  workspaceEvents       WorkspaceEvent[]
  terminalSessions      WorkspaceTerminalSession[]
  collabSessions        CollabSession[]
  collabMessages        CollabMessage[]
  aiConversations       AiConversation[]
  aiAssistantUsageRecords AiAssistantUsageRecord[]

  @@unique([organizationId, key])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model ProjectRoleAssignment {
  id           String      @id @default(cuid())
  projectId    String
  userId       String
  role         ProjectRole @default(DEVELOPER)
  canRunAi     Boolean     @default(false)
  assignedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User        @relation("ProjectAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?       @relation("ProjectAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

model OrganizationAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String?
  action         String
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskActivityType {
  TASK_CREATED
  TITLE_UPDATED
  DESCRIPTION_UPDATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  LABELS_UPDATED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_ARCHIVED
  TASK_RESTORED
  PR_LINKED
  PR_UNLINKED
  AI_RUN_STARTED
  AI_PLAN_APPROVED
  AI_PLAN_REJECTED
  AI_PROPOSAL_READY
  AI_PROPOSAL_ACCEPTED
  AI_PROPOSAL_REJECTED
  WORKSPACE_AI_PATCH_APPLIED
  COLLAB_SESSION_STARTED
  COLLAB_SESSION_CLOSED
  AI_ASSISTANT_PATCH_APPLIED
}

enum GitHubInstallationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum RepositoryConnectionStatus {
  CONNECTED
  DISCONNECTED
  ACCESS_REVOKED
  ERROR
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum InternalReviewDecision {
  NONE
  NEEDS_DISCUSSION
  CHANGES_SUGGESTED
  READY_FOR_REVIEW
  INTERNALLY_APPROVED
}

enum ReviewThreadStatus {
  OPEN
  RESOLVED
}

enum DiffLineSide {
  LEFT
  RIGHT
}

model Task {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  sequenceNumber Int
  identifier     String
  title          String
  description    String?        @db.Text
  status         TaskStatus     @default(TODO)
  priority       TaskPriority   @default(MEDIUM)
  assigneeId     String?
  creatorId      String?
  dueDate        DateTime?
  labels         String[]
  completedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User?          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  comments       TaskComment[]
  activities       TaskActivity[]
  pullRequestLinks TaskPullRequestLink[]
  agentRuns        AgentRun[]
  devWorkspaces    DevWorkspace[]
  collabSessions   CollabSession[]
  aiConversations  AiConversation[]

  @@unique([projectId, sequenceNumber])
  @@unique([projectId, identifier])
  @@index([projectId, archivedAt, status, updatedAt])
  @@index([assigneeId, archivedAt, status])
  @@index([organizationId, archivedAt])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  body      String    @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskActivity {
  id        String           @id @default(cuid())
  taskId    String
  projectId String
  actorId   String?
  eventType TaskActivityType
  field     String?
  oldValue  String?
  newValue  String?
  summary   String
  createdAt DateTime         @default(now())
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
}

model GitHubAppInstallation {
  id                   String                           @id @default(cuid())
  githubInstallationId String                           @unique
  accountLogin         String
  accountType          String
  accountAvatarUrl     String?
  status               GitHubInstallationStatus         @default(ACTIVE)
  permissions          Json?
  suspendedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  organizations        OrganizationGitHubInstallation[]
  repositories         ProjectRepository[]
}

model OrganizationGitHubInstallation {
  id             String                @id @default(cuid())
  organizationId String
  installationId String
  connectedById  String?
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation   GitHubAppInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connectedBy    User?                 @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, installationId])
  @@index([installationId])
}

model GitHubInstallSession {
  id             String       @id @default(cuid())
  stateHash      String       @unique
  userId         String
  organizationId String
  projectId      String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ProjectRepository {
  id             String                     @id @default(cuid())
  organizationId String
  projectId      String
  installationId String
  githubRepoId   String
  owner          String
  name           String
  fullName       String
  defaultBranch  String
  description    String?                    @db.Text
  htmlUrl        String
  isPrivate      Boolean                    @default(false)
  status         RepositoryConnectionStatus @default(CONNECTED)
  activeLock     String?
  connectedById  String?
  connectedAt    DateTime                   @default(now())
  disconnectedAt DateTime?
  lastSyncedAt   DateTime?
  lastSyncStatus String?
  lastSyncError  String?                    @db.Text
  openPrCount    Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installation   GitHubAppInstallation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connectedBy    User?                      @relation("RepoConnector", fields: [connectedById], references: [id], onDelete: SetNull)
  pullRequests   PullRequest[]
  agentRuns      AgentRun[]
  devWorkspaces  DevWorkspace[]

  @@unique([projectId, activeLock])
  @@index([organizationId, projectId, status])
  @@index([githubRepoId, status])
  @@index([installationId])
}

model PullRequest {
  id                   String                      @id @default(cuid())
  organizationId       String
  projectId            String
  projectRepositoryId  String
  githubPrId           String
  number               Int
  title                String
  body                 String?                     @db.Text
  state                PullRequestState
  isDraft              Boolean                     @default(false)
  authorLogin          String
  authorAvatarUrl      String?
  headRef              String
  baseRef              String
  headSha              String
  mergeableState       String?
  githubReviewDecision String?
  additions            Int                         @default(0)
  deletions            Int                         @default(0)
  changedFilesCount    Int                         @default(0)
  htmlUrl              String
  githubCreatedAt      DateTime
  githubUpdatedAt      DateTime
  mergedAt             DateTime?
  closedAt             DateTime?
  lastSyncedAt         DateTime                    @default(now())
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRepository    ProjectRepository           @relation(fields: [projectRepositoryId], references: [id], onDelete: Cascade)
  reviewComments       PullRequestReviewComment[]
  internalReviews      PullRequestInternalReview[]
  taskLinks            TaskPullRequestLink[]

  @@unique([projectRepositoryId, number])
  @@index([projectRepositoryId, state, githubUpdatedAt])
  @@index([projectId, state, githubUpdatedAt])
}

model PullRequestReviewComment {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  pullRequestId  String
  authorId       String?
  body           String             @db.Text
  filePath       String?
  lineNumber     Int?
  lineSide       DiffLineSide?
  commitSha      String
  status         ReviewThreadStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  editedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest        @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  author         User?              @relation("PRCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy     User?              @relation("PRCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([pullRequestId, createdAt])
  @@index([pullRequestId, filePath, createdAt])
}

model PullRequestInternalReview {
  id             String                 @id @default(cuid())
  organizationId String
  projectId      String
  pullRequestId  String
  reviewerId     String
  decision       InternalReviewDecision
  summary        String?                @db.Text
  commitSha      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest            @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer       User                   @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, reviewerId])
  @@index([pullRequestId, updatedAt])
}

model TaskPullRequestLink {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String
  pullRequestId  String
  linkedById     String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest  @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  linkedBy       User?        @relation("TaskPrLinker", fields: [linkedById], references: [id], onDelete: SetNull)

  @@unique([taskId, pullRequestId])
  @@index([pullRequestId])
}

model GitHubWebhookDelivery {
  id                   String    @id @default(cuid())
  deliveryId           String    @unique
  event                String
  action               String?
  githubInstallationId String?
  githubRepoId         String?
  status               String
  errorMessage         String?   @db.Text
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?

  @@index([receivedAt])
}

enum AgentRunStatus {
  QUEUED
  PLANNING
  AWAITING_APPROVAL
  RUNNING
  AWAITING_REVIEW
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum AgentPlanStatus {
  PENDING
  SUPERSEDED
  APPROVED
  REJECTED
}

enum AgentProposalStatus {
  PENDING_REVIEW
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum AgentTestRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  SKIPPED
  UNAVAILABLE
}

enum AgentRunEventType {
  RUN_QUEUED
  CONTEXT_COLLECTED
  PLAN_GENERATED
  PLAN_APPROVED
  PLAN_REJECTED
  PLAN_REVISION_REQUESTED
  EXECUTION_CLAIMED
  PATCH_VALIDATED
  PATCH_REJECTED
  REVIEW_GENERATED
  TESTS_EXECUTED
  TESTS_UNAVAILABLE
  PROPOSAL_CREATED
  PROPOSAL_REVISION_REQUESTED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  RUN_CANCELLED
  RUN_FAILED
}

enum AgentStageRole {
  PLANNER
  IMPLEMENTER
  REVIEWER
}

model AgentProfile {
  id           String         @id @default(cuid())
  key          String         @unique
  name         String
  role         AgentStageRole
  description  String
  systemPrompt String         @db.Text
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AgentRun {
  id                  String              @id @default(cuid())
  organizationId      String
  projectId           String
  taskId              String
  projectRepositoryId String?
  triggeredById       String?
  status              AgentRunStatus      @default(QUEUED)
  requestedPhase      String              @default("PLAN")
  currentStage        String?
  idempotencyKey      String?
  repoFullName        String
  baseBranch          String
  baseCommitSha       String?
  taskSnapshotTitle   String
  taskSnapshotHash    String
  userInstructions    String?             @db.Text
  provider            String
  model               String
  activePlanId        String?
  activeProposalId    String?
  workerId            String?
  leaseExpiresAt      DateTime?
  attemptCount        Int                 @default(0)
  maxAttempts         Int                 @default(2)
  cancelRequestedAt   DateTime?
  errorCode           String?
  errorMessage        String?             @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectRepository   ProjectRepository?  @relation(fields: [projectRepositoryId], references: [id], onDelete: SetNull)
  triggeredBy         User?               @relation("AgentRunTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  plans               AgentPlan[]
  proposals           AgentProposal[]
  testRuns            AgentTestRun[]
  events              AgentRunEvent[]
  usageRecords        AgentUsageRecord[]

  @@unique([projectId, idempotencyKey])
  @@index([status, leaseExpiresAt, createdAt])
  @@index([projectId, taskId, createdAt])
  @@index([organizationId, createdAt])
}

model AgentRunEvent {
  id             String            @id @default(cuid())
  runId          String
  organizationId String
  projectId      String
  actorId        String?
  eventType      AgentRunEventType
  statusFrom     AgentRunStatus?
  statusTo       AgentRunStatus?
  message        String
  metadata       Json?
  createdAt      DateTime          @default(now())
  run            AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor          User?             @relation("AgentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([projectId, createdAt])
}

model AgentPlan {
  id               String          @id @default(cuid())
  runId            String
  version          Int
  status           AgentPlanStatus @default(PENDING)
  summary          String          @db.Text
  steps            Json
  targetFiles      String[]
  risks            String[]
  suggestedChecks  String[]
  contextSummary   Json
  revisionFeedback String?         @db.Text
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?         @db.Text
  createdAt        DateTime        @default(now())
  run              AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  decidedBy        User?           @relation("AgentPlanDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  proposals        AgentProposal[]

  @@unique([runId, version])
  @@index([runId, createdAt])
}

model AgentProposal {
  id                String              @id @default(cuid())
  runId             String
  planId            String
  version           Int
  status            AgentProposalStatus @default(PENDING_REVIEW)
  summary           String              @db.Text
  reviewSummary     String              @db.Text
  reviewFindings    Json
  changedFiles      Json
  rawPatch          String              @db.Text
  filesChangedCount Int                 @default(0)
  additionsCount    Int                 @default(0)
  deletionsCount    Int                 @default(0)
  baseCommitSha     String
  revisionFeedback  String?             @db.Text
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?             @db.Text
  createdAt         DateTime            @default(now())
  run               AgentRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  plan              AgentPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewedBy        User?               @relation("AgentProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  testRuns          AgentTestRun[]

  @@unique([runId, version])
  @@index([runId, createdAt])
}

model AgentTestRun {
  id            String             @id @default(cuid())
  runId         String
  proposalId    String?
  status        AgentTestRunStatus
  command       String?
  exitCode      Int?
  durationMs    Int?
  stdoutExcerpt String?            @db.Text
  stderrExcerpt String?            @db.Text
  explanation   String             @db.Text
  sandboxed     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  completedAt   DateTime?
  run           AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  proposal      AgentProposal?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
}

model AgentUsageRecord {
  id               String         @id @default(cuid())
  runId            String
  organizationId   String
  projectId        String
  stageRole        AgentStageRole
  provider         String
  model            String
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  totalTokens      Int            @default(0)
  estimatedCostUsd Decimal        @db.Decimal(12, 6)
  latencyMs        Int            @default(0)
  createdAt        DateTime       @default(now())
  run              AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([runId, createdAt])
}

enum DevWorkspaceStatus {
  CREATING
  READY
  ACTIVE
  SUSPENDED
  STOPPED
  FAILED
  EXPIRED
}

enum WorkspaceStorageMode {
  EPHEMERAL
  LOCAL_VOLUME
  DURABLE
}

enum WorkspaceSnapshotStatus {
  AVAILABLE
  RESTORED
  EXPIRED
  MISSING
}

enum WorkspaceEventType {
  WORKSPACE_CREATED
  REPOSITORY_INITIALIZED
  WORKSPACE_RESUMED
  WORKSPACE_SUSPENDED
  WORKSPACE_STOPPED
  WORKSPACE_DELETED
  WORKSPACE_FAILED
  SNAPSHOT_CREATED
  SNAPSHOT_RESTORED
  FILE_SAVED
  FILE_CREATED
  FILE_RENAMED
  FILE_DELETED
  GIT_STAGE_CHANGED
  GIT_COMMIT_CREATED
  GIT_BRANCH_SWITCHED
  AI_PATCH_APPLIED
  TERMINAL_SESSION_STARTED
  TERMINAL_SESSION_ENDED
  TERMINAL_REJECTED
  COLLAB_SESSION_STARTED
  COLLAB_SESSION_CLOSED
  COLLAB_PARTICIPANT_JOINED
  COLLAB_PARTICIPANT_REVOKED
  COLLAB_FILE_FLUSHED
  AI_ASSISTANT_PATCH_APPLIED
}

enum WorkspaceTerminalSessionStatus {
  ACTIVE
  ENDED
  REJECTED
}

model DevWorkspace {
  id                  String                     @id @default(cuid())
  organizationId      String
  projectId           String
  projectRepositoryId String?
  ownerId             String
  taskId              String?
  name                String
  status              DevWorkspaceStatus         @default(CREATING)
  storageMode         WorkspaceStorageMode       @default(EPHEMERAL)
  storageWarning      String?                    @db.Text
  repoFullName        String
  baseBranch          String
  baseCommitSha       String?
  currentBranch       String?
  lastCommitSha       String?
  workspacePathKey    String                     @unique
  dirtyFileCount      Int                        @default(0)
  workerId            String?
  errorCode           String?
  errorMessage        String?                    @db.Text
  lastActiveAt        DateTime                   @default(now())
  suspendedAt         DateTime?
  stoppedAt           DateTime?
  expiresAt           DateTime?
  deletedAt           DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRepository   ProjectRepository?         @relation(fields: [projectRepositoryId], references: [id], onDelete: SetNull)
  owner               User                       @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  task                Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  snapshots           WorkspaceSnapshot[]
  events              WorkspaceEvent[]
  terminalSessions    WorkspaceTerminalSession[]
  collabSessions      CollabSession[]
  aiConversations     AiConversation[]

  @@index([organizationId, projectId, status, deletedAt])
  @@index([ownerId, status, deletedAt])
  @@index([expiresAt, status])
}

model WorkspaceSnapshot {
  id                 String                  @id @default(cuid())
  workspaceId        String
  baseCommitSha      String
  branchName         String
  status             WorkspaceSnapshotStatus @default(AVAILABLE)
  storageKey         String
  sizeBytes          Int                     @default(0)
  checksumSha256     String
  trackedFileCount   Int                     @default(0)
  untrackedFileCount Int                     @default(0)
  createdById        String?
  createdAt          DateTime                @default(now())
  restoredAt         DateTime?
  workspace          DevWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User?                   @relation("WorkspaceSnapshotCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model WorkspaceEvent {
  id             String             @id @default(cuid())
  workspaceId    String
  organizationId String
  projectId      String
  actorId        String?
  eventType      WorkspaceEventType
  message        String
  metadata       Json?
  createdAt      DateTime           @default(now())
  workspace      DevWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor          User?              @relation("WorkspaceEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}

model WorkspaceTerminalSession {
  id             String                         @id @default(cuid())
  workspaceId    String
  organizationId String
  projectId      String
  userId         String
  status         WorkspaceTerminalSessionStatus @default(ACTIVE)
  sandboxed      Boolean                        @default(false)
  reason         String?
  exitCode       Int?
  startedAt      DateTime                       @default(now())
  endedAt        DateTime?
  workspace      DevWorkspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User                           @relation("WorkspaceTerminalUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, startedAt])
}

enum CollabSessionStatus {
  ACTIVE
  CLOSED
}

enum CollabRole {
  OWNER
  EDITOR
  VIEWER
}

enum CollabParticipantStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiInlineActionKind {
  CHAT
  EXPLAIN
  IMPROVE
  FIND_BUGS
  GENERATE_TESTS
}

enum AiMessageStatus {
  STREAMING
  COMPLETED
  CANCELLED
  FAILED
}

model CollabSession {
  id             String              @id @default(cuid())
  organizationId String
  projectId      String
  workspaceId    String
  taskId         String?
  createdById    String
  closedById     String?
  title          String
  status         CollabSessionStatus @default(ACTIVE)
  activeFilePath String?
  lastActivityAt DateTime            @default(now())
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace      DevWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task           Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("CollabSessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  closedBy       User?               @relation("CollabSessionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  participants   CollabParticipant[]
  documents      CollabDocument[]
  messages       CollabMessage[]
  aiConversations AiConversation[]

  @@index([organizationId, projectId, status, updatedAt])
  @@index([workspaceId, status])
}

model CollabParticipant {
  id            String                  @id @default(cuid())
  sessionId     String
  userId        String
  invitedById   String?
  role          CollabRole              @default(EDITOR)
  status        CollabParticipantStatus @default(ACTIVE)
  colorHex      String                  @default("#3b82f6")
  revokedReason String?
  joinedAt      DateTime                @default(now())
  leftAt        DateTime?
  revokedAt     DateTime?
  lastSeenAt    DateTime                @default(now())
  session       CollabSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User                    @relation("CollabParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy     User?                   @relation("CollabParticipantInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId, status])
}

model CollabDocument {
  id               String        @id @default(cuid())
  sessionId        String
  filePath         String
  docKey           String
  storageKey       String
  versionSeq       Int           @default(1)
  contentSha256    String
  lastModifiedById String?
  deletedAt        DateTime?
  lastSavedAt      DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  session          CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lastModifiedBy   User?         @relation("CollabDocumentEditor", fields: [lastModifiedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, filePath])
  @@unique([sessionId, docKey])
  @@index([sessionId, deletedAt, updatedAt])
}

model CollabMessage {
  id             String        @id @default(cuid())
  sessionId      String
  organizationId String
  projectId      String
  authorId       String?
  body           String        @db.Text
  filePath       String?
  lineNumber     Int?
  createdAt      DateTime      @default(now())
  session        CollabSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author         User?         @relation("CollabMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
}

model AiConversation {
  id                  String                   @id @default(cuid())
  organizationId      String
  projectId           String
  userId              String
  workspaceId         String?
  taskId              String?
  collabSessionId     String?
  title               String
  isSharedWithSession Boolean                  @default(false)
  lastActiveFile      String?
  archivedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User                     @relation("AiConversationOwner", fields: [userId], references: [id], onDelete: Cascade)
  workspace           DevWorkspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  task                Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  collabSession       CollabSession?           @relation(fields: [collabSessionId], references: [id], onDelete: SetNull)
  messages            AiMessage[]
  usageRecords        AiAssistantUsageRecord[]

  @@index([organizationId, projectId, userId, updatedAt])
  @@index([collabSessionId, isSharedWithSession])
}

model AiMessage {
  id              String                   @id @default(cuid())
  conversationId  String
  authorId        String?
  role            AiMessageRole
  actionKind      AiInlineActionKind       @default(CHAT)
  status          AiMessageStatus          @default(COMPLETED)
  content         String                   @db.Text
  errorMessage    String?                  @db.Text
  attachedContext Json?
  citations       Json?
  proposalJson    Json?
  provider        String?
  model           String?
  inputTokens     Int                      @default(0)
  outputTokens    Int                      @default(0)
  latencyMs       Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  conversation    AiConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author          User?                    @relation("AiMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  usageRecords    AiAssistantUsageRecord[]

  @@index([conversationId, createdAt])
}

model AiAssistantUsageRecord {
  id               String             @id @default(cuid())
  conversationId   String
  messageId        String?
  organizationId   String
  projectId        String
  userId           String?
  actionKind       AiInlineActionKind @default(CHAT)
  provider         String
  model            String
  inputTokens      Int                @default(0)
  outputTokens     Int                @default(0)
  totalTokens      Int                @default(0)
  estimatedCostUsd Decimal            @db.Decimal(12, 6)
  latencyMs        Int                @default(0)
  createdAt        DateTime           @default(now())
  conversation     AiConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message          AiMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User?              @relation("AiAssistantUsageUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
}
