generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id                   String                   @id @default(cuid())
  name                 String?
  email                String                   @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  accounts             Account[]
  sessions             Session[]
  memberships          OrganizationMembership[]
  sentInvitations      OrganizationInvitation[] @relation("InvitationSender")
  acceptedInvitations  OrganizationInvitation[] @relation("InvitationAcceptor")
  createdProjects      Project[]                @relation("ProjectCreator")
  projectRoles         ProjectRoleAssignment[]  @relation("ProjectAssignee")
  assignedProjectRoles ProjectRoleAssignment[]  @relation("ProjectAssigner")
  auditLogs            OrganizationAuditLog[]
  assignedTasks        Task[]                   @relation("TaskAssignee")
  createdTasks         Task[]                   @relation("TaskCreator")
  taskComments         TaskComment[]
  taskActivities       TaskActivity[]
  githubInstallations  OrganizationGitHubInstallation[]
  githubInstallStates  GitHubInstallSession[]
  connectedRepos       ProjectRepository[]      @relation("RepoConnector")
  prReviewComments     PullRequestReviewComment[] @relation("PRCommentAuthor")
  resolvedPrComments   PullRequestReviewComment[] @relation("PRCommentResolver")
  prInternalReviews    PullRequestInternalReview[]
  linkedTaskPrs        TaskPullRequestLink[]    @relation("TaskPrLinker")
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
}
model Session {
  sessionToken String @id
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@id([identifier, token])
}
model AuthAttempt {
  key String @id
  count Int
  expires DateTime
  @@index([expires])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  description String?                  @db.Text
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  projects    Project[]
  auditLogs   OrganizationAuditLog[]
  tasks       Task[]
  githubInstallations OrganizationGitHubInstallation[]
  githubInstallStates GitHubInstallSession[]
  projectRepositories ProjectRepository[]
  pullRequests        PullRequest[]
  prReviewComments    PullRequestReviewComment[]
  prInternalReviews   PullRequestInternalReview[]
  taskPrLinks         TaskPullRequestLink[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(MEMBER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  activeLock     String?
  invitedById    String?
  acceptedById   String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, email, activeLock])
  @@index([organizationId, status])
  @@index([email, status])
}

model Project {
  id              String                  @id @default(cuid())
  organizationId  String
  name            String
  key             String
  slug            String
  description     String?                 @db.Text
  status          ProjectStatus           @default(ACTIVE)
  nextTaskNumber  Int                     @default(1)
  createdById     String?
  archivedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?                   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  roleAssignments ProjectRoleAssignment[]
  auditLogs       OrganizationAuditLog[]
  tasks           Task[]
  taskActivities  TaskActivity[]
  githubInstallStates GitHubInstallSession[]
  repositories    ProjectRepository[]
  pullRequests    PullRequest[]
  prReviewComments PullRequestReviewComment[]
  prInternalReviews PullRequestInternalReview[]
  taskPrLinks     TaskPullRequestLink[]

  @@unique([organizationId, key])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model ProjectRoleAssignment {
  id           String      @id @default(cuid())
  projectId    String
  userId       String
  role         ProjectRole @default(DEVELOPER)
  assignedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User        @relation("ProjectAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?       @relation("ProjectAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

model OrganizationAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String?
  action         String
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskActivityType {
  TASK_CREATED
  TITLE_UPDATED
  DESCRIPTION_UPDATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  LABELS_UPDATED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_ARCHIVED
  TASK_RESTORED
  PR_LINKED
  PR_UNLINKED
}

enum GitHubInstallationStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum RepositoryConnectionStatus {
  CONNECTED
  DISCONNECTED
  ACCESS_REVOKED
  ERROR
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum InternalReviewDecision {
  NONE
  NEEDS_DISCUSSION
  CHANGES_SUGGESTED
  READY_FOR_REVIEW
  INTERNALLY_APPROVED
}

enum ReviewThreadStatus {
  OPEN
  RESOLVED
}

enum DiffLineSide {
  LEFT
  RIGHT
}

model Task {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  sequenceNumber Int
  identifier     String
  title          String
  description    String?        @db.Text
  status         TaskStatus     @default(TODO)
  priority       TaskPriority   @default(MEDIUM)
  assigneeId     String?
  creatorId      String?
  dueDate        DateTime?
  labels         String[]
  completedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User?          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  comments       TaskComment[]
  activities     TaskActivity[]
  pullRequestLinks TaskPullRequestLink[]

  @@unique([projectId, sequenceNumber])
  @@unique([projectId, identifier])
  @@index([projectId, archivedAt, status, updatedAt])
  @@index([assigneeId, archivedAt, status])
  @@index([organizationId, archivedAt])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  body      String    @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskActivity {
  id        String           @id @default(cuid())
  taskId    String
  projectId String
  actorId   String?
  eventType TaskActivityType
  field     String?
  oldValue  String?
  newValue  String?
  summary   String
  createdAt DateTime         @default(now())
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
}

model GitHubAppInstallation {
  id                   String                           @id @default(cuid())
  githubInstallationId String                           @unique
  accountLogin         String
  accountType          String
  accountAvatarUrl     String?
  status               GitHubInstallationStatus         @default(ACTIVE)
  permissions          Json?
  suspendedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  organizations        OrganizationGitHubInstallation[]
  repositories         ProjectRepository[]
}

model OrganizationGitHubInstallation {
  id             String                @id @default(cuid())
  organizationId String
  installationId String
  connectedById  String?
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation   GitHubAppInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connectedBy    User?                 @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, installationId])
  @@index([installationId])
}

model GitHubInstallSession {
  id             String       @id @default(cuid())
  stateHash      String       @unique
  userId         String
  organizationId String
  projectId      String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ProjectRepository {
  id             String                     @id @default(cuid())
  organizationId String
  projectId      String
  installationId String
  githubRepoId   String
  owner          String
  name           String
  fullName       String
  defaultBranch  String
  description    String?                    @db.Text
  htmlUrl        String
  isPrivate      Boolean                    @default(false)
  status         RepositoryConnectionStatus @default(CONNECTED)
  activeLock     String?
  connectedById  String?
  connectedAt    DateTime                   @default(now())
  disconnectedAt DateTime?
  lastSyncedAt   DateTime?
  lastSyncStatus String?
  lastSyncError  String?                    @db.Text
  openPrCount    Int                        @default(0)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installation   GitHubAppInstallation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connectedBy    User?                      @relation("RepoConnector", fields: [connectedById], references: [id], onDelete: SetNull)
  pullRequests   PullRequest[]

  @@unique([projectId, activeLock])
  @@index([organizationId, projectId, status])
  @@index([githubRepoId, status])
  @@index([installationId])
}

model PullRequest {
  id                   String                      @id @default(cuid())
  organizationId       String
  projectId            String
  projectRepositoryId  String
  githubPrId           String
  number               Int
  title                String
  body                 String?                     @db.Text
  state                PullRequestState
  isDraft              Boolean                     @default(false)
  authorLogin          String
  authorAvatarUrl      String?
  headRef              String
  baseRef              String
  headSha              String
  mergeableState       String?
  githubReviewDecision String?
  additions            Int                         @default(0)
  deletions            Int                         @default(0)
  changedFilesCount    Int                         @default(0)
  htmlUrl              String
  githubCreatedAt      DateTime
  githubUpdatedAt      DateTime
  mergedAt             DateTime?
  closedAt             DateTime?
  lastSyncedAt         DateTime                    @default(now())
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectRepository    ProjectRepository           @relation(fields: [projectRepositoryId], references: [id], onDelete: Cascade)
  reviewComments       PullRequestReviewComment[]
  internalReviews      PullRequestInternalReview[]
  taskLinks            TaskPullRequestLink[]

  @@unique([projectRepositoryId, number])
  @@index([projectRepositoryId, state, githubUpdatedAt])
  @@index([projectId, state, githubUpdatedAt])
}

model PullRequestReviewComment {
  id             String             @id @default(cuid())
  organizationId String
  projectId      String
  pullRequestId  String
  authorId       String?
  body           String             @db.Text
  filePath       String?
  lineNumber     Int?
  lineSide       DiffLineSide?
  commitSha      String
  status         ReviewThreadStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  editedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest        @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  author         User?              @relation("PRCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy     User?              @relation("PRCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([pullRequestId, createdAt])
  @@index([pullRequestId, filePath, createdAt])
}

model PullRequestInternalReview {
  id             String                 @id @default(cuid())
  organizationId String
  projectId      String
  pullRequestId  String
  reviewerId     String
  decision       InternalReviewDecision
  summary        String?                @db.Text
  commitSha      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest            @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer       User                   @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, reviewerId])
  @@index([pullRequestId, updatedAt])
}

model TaskPullRequestLink {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String
  pullRequestId  String
  linkedById     String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  pullRequest    PullRequest  @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  linkedBy       User?        @relation("TaskPrLinker", fields: [linkedById], references: [id], onDelete: SetNull)

  @@unique([taskId, pullRequestId])
  @@index([pullRequestId])
}

model GitHubWebhookDelivery {
  id                   String    @id @default(cuid())
  deliveryId           String    @unique
  event                String
  action               String?
  githubInstallationId String?
  githubRepoId         String?
  status               String
  errorMessage         String?   @db.Text
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?

  @@index([receivedAt])
}
