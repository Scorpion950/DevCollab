generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id                   String                   @id @default(cuid())
  name                 String?
  email                String                   @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  accounts             Account[]
  sessions             Session[]
  memberships          OrganizationMembership[]
  sentInvitations      OrganizationInvitation[] @relation("InvitationSender")
  acceptedInvitations  OrganizationInvitation[] @relation("InvitationAcceptor")
  createdProjects      Project[]                @relation("ProjectCreator")
  projectRoles         ProjectRoleAssignment[]  @relation("ProjectAssignee")
  assignedProjectRoles ProjectRoleAssignment[]  @relation("ProjectAssigner")
  auditLogs            OrganizationAuditLog[]
  assignedTasks        Task[]                   @relation("TaskAssignee")
  createdTasks         Task[]                   @relation("TaskCreator")
  taskComments         TaskComment[]
  taskActivities       TaskActivity[]
}
model Account {
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
  @@index([userId])
}
model Session {
  sessionToken String @id
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@id([identifier, token])
}
model AuthAttempt {
  key String @id
  count Int
  expires DateTime
  @@index([expires])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectRole {
  PROJECT_MANAGER
  DEVELOPER
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  description String?                  @db.Text
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  projects    Project[]
  auditLogs   OrganizationAuditLog[]
  tasks       Task[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(MEMBER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  activeLock     String?
  invitedById    String?
  acceptedById   String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, email, activeLock])
  @@index([organizationId, status])
  @@index([email, status])
}

model Project {
  id              String                  @id @default(cuid())
  organizationId  String
  name            String
  key             String
  slug            String
  description     String?                 @db.Text
  status          ProjectStatus           @default(ACTIVE)
  nextTaskNumber  Int                     @default(1)
  createdById     String?
  archivedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?                   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  roleAssignments ProjectRoleAssignment[]
  auditLogs       OrganizationAuditLog[]
  tasks           Task[]
  taskActivities  TaskActivity[]

  @@unique([organizationId, key])
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model ProjectRoleAssignment {
  id           String      @id @default(cuid())
  projectId    String
  userId       String
  role         ProjectRole @default(DEVELOPER)
  assignedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User        @relation("ProjectAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?       @relation("ProjectAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
}

model OrganizationAuditLog {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String?
  action         String
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskActivityType {
  TASK_CREATED
  TITLE_UPDATED
  DESCRIPTION_UPDATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  LABELS_UPDATED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_ARCHIVED
  TASK_RESTORED
}

model Task {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  sequenceNumber Int
  identifier     String
  title          String
  description    String?        @db.Text
  status         TaskStatus     @default(TODO)
  priority       TaskPriority   @default(MEDIUM)
  assigneeId     String?
  creatorId      String?
  dueDate        DateTime?
  labels         String[]
  completedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User?          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  comments       TaskComment[]
  activities     TaskActivity[]

  @@unique([projectId, sequenceNumber])
  @@unique([projectId, identifier])
  @@index([projectId, archivedAt, status, updatedAt])
  @@index([assigneeId, archivedAt, status])
  @@index([organizationId, archivedAt])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  body      String    @db.Text
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskActivity {
  id        String           @id @default(cuid())
  taskId    String
  projectId String
  actorId   String?
  eventType TaskActivityType
  field     String?
  oldValue  String?
  newValue  String?
  summary   String
  createdAt DateTime         @default(now())
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
}
