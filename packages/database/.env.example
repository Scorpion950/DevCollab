# @devcollab/database — Copy to packages/database/.env
# Both URLs must target the same Neon PostgreSQL database & branch.

# Direct (unpooled) connection required by Prisma CLI migrations (`prisma.config.ts`)
DIRECT_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Pooled Neon connection used by Prisma Client runtime & connectivity checks
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
