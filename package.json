{
  "name": "devcollab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @devcollab/database build && pnpm --parallel --filter @devcollab/web --filter @devcollab/api dev",
    "dev:web": "pnpm --filter @devcollab/database build && pnpm --filter @devcollab/web dev",
    "dev:api": "pnpm --filter @devcollab/database build && pnpm --filter @devcollab/api dev",
    "dev:worker": "pnpm --filter @devcollab/database build && pnpm --filter @devcollab/ai-core build && pnpm --filter @devcollab/worker dev",
    "start": "pnpm --parallel --filter @devcollab/web --filter @devcollab/api start",
    "start:worker": "pnpm --filter @devcollab/worker start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @devcollab/database build && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "db:generate": "pnpm --filter @devcollab/database generate",
    "db:validate": "pnpm --filter @devcollab/database validate",
    "db:migrate": "pnpm --filter @devcollab/database migrate:dev",
    "db:deploy": "pnpm --filter @devcollab/database migrate:deploy",
    "db:check": "pnpm --filter @devcollab/database check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
